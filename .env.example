# Tab Organizer Configuration

# AI Provider Configuration
# Options: openrouter, ollama, openai, anthropic, deepseek, gemini
# (docker-compose defaults to openrouter; this file's defaults run fully local via Ollama)
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Model Configuration
# Keep EMBEDDING_DIMENSIONS in sync with EMBEDDING_MODEL — mismatched values
# will be rejected by the AI Engine when writing to LanceDB.
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Ollama Configuration (for local models)
OLLAMA_HOST=http://ollama:11434

# API Keys (required for cloud providers)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Vector store (LanceDB on disk, mounted from the lancedb-data Docker volume)
VECTOR_DB_PATH=/data/lancedb

# Scraping Configuration
MAX_CONCURRENT_SCRAPES=10
SCRAPE_TIMEOUT=30
RESPECT_ROBOTS=true

# Security
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
