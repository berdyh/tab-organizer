# Tab Organizer Configuration

# AI Provider Configuration
# Options: openrouter, ollama, openai, anthropic, claude_code, codex_cli, codex_acp, deepseek, gemini
# Matches the docker-compose/ai_models.yaml default: cloud via OpenRouter. Set
# OPENROUTER_API_KEY below or the AI Engine's /health reports {"status": "degraded"}
# and every embed/chat/search call fails closed. To run fully local instead, set
# both to `ollama`, pull the models with `./scripts/cli.py init --models`, and
# leave the cloud API key vars blank.
AI_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter

# Model Configuration
# Keep EMBEDDING_DIMENSIONS in sync with EMBEDDING_MODEL — mismatched values
# will be rejected by the AI Engine when writing to LanceDB.
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Ollama Configuration (for local models)
# Docker services use http://ollama:11434. Host AI mode rewrites this to
# http://localhost:11434 unless --ollama-host is supplied.
OLLAMA_HOST=http://ollama:11434

# Subscription-backed CLI providers (LLM only)
# Use AI_PROVIDER=claude_code after `claude` is authenticated, or
# AI_PROVIDER=codex_cli after `codex login`, or AI_PROVIDER=codex_acp after
# `acpx` and its Codex ACP adapter are available. codex_cli is one-shot
# `codex exec`; codex_acp uses the ACP harness path. Leave LLM_MODEL blank
# unless you explicitly need a provider-specific model. Keep embeddings on
# Ollama or another embedding-capable provider. The stock Docker image does not
# install these CLIs/adapters; use them from a host-run AI engine or a custom
# image that includes CLI auth. Host mode:
#   ./scripts/cli.py host-ai --provider claude_code
#   ./scripts/cli.py start -d --host-ai
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_TIMEOUT=300
CLAUDE_CODE_DISABLE_TOOLS=true
CODEX_CLI_COMMAND=codex
CODEX_CLI_TIMEOUT=300
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_ALLOW_UNTRUSTED_CONTEXT=false
CODEX_ACP_COMMAND=acpx
CODEX_ACP_TIMEOUT=300
CODEX_ACP_PERMISSION_MODE=deny-all
CODEX_ACP_NON_INTERACTIVE_PERMISSIONS=fail
CODEX_ACP_QUEUE_TTL_SECONDS=0.1
CODEX_ACP_SESSION_NAME=

# API Keys (required for cloud providers)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Bearer tokens for local service-to-service calls. Leave these BLANK and let
# ./scripts/cli.py start (or host-ai) mint them: it generates one INDEPENDENT
# token per trust scope and persists them in data/service-tokens.json (0600) so
# they stay stable across restarts.
#
# If you set them yourself, they must be four DIFFERENT values. Reusing one
# value collapses the trust scopes: browser-engine accepts only
# BROWSER_ENGINE_API_TOKEN, so a shared value would let the agent principal
# reach the scrape, CDP tab-control and credential/auth-queue endpoints.
AI_ENGINE_API_TOKEN=
BROWSER_ENGINE_API_TOKEN=
BACKEND_CALLBACK_TOKEN=
BACKEND_AGENT_API_TOKEN=
AI_ENGINE_ALLOW_UNAUTHENTICATED=false

# Vector store (LanceDB on disk, mounted from the lancedb-data Docker volume)
VECTOR_DB_PATH=/data/lancedb

# Backend state store (sessions, URL records, callback metadata, clusters, platform users)
BACKEND_DB_PATH=./data/backend/tab-organizer.sqlite3
# Public backend base URL used in generated B2B first-call examples.
BACKEND_PUBLIC_URL=http://localhost:8080

# Local maintainer bootstrap code for platform issue review accounts
PLATFORM_MAINTAINER_SIGNUP_CODE=

# Scraping Configuration
MAX_CONCURRENT_SCRAPES=10
SCRAPE_TIMEOUT=30
RESPECT_ROBOTS=true
# Keep false unless you intentionally want to scrape localhost/private-network
# URLs from this machine.
SCRAPE_ALLOW_PRIVATE_NETWORKS=false

# Security
# Browser origins allowed to read backend-core / ai-engine / browser-engine
# responses (comma-separated). Empty = the Web UI on localhost:8089 only.
# These services have no legitimate browser-side caller (Streamlit calls them
# server-side), so widening this -- especially to "*" -- lets any page the user
# has open read the whole corpus.
CORS_ALLOWED_ORIGINS=

# Browser Engine's credential store (for auth-walled scraping) is fail-closed:
# it does NOT fall back to an OS keyring in the shipped image (the `keyring`
# package is not an installed dependency, so that resolution path is dormant),
# so this is the only key source. Left blank (the default), the store cannot
# encrypt and POST /auth/credentials returns 503 -- the credential/auth-scraping
# feature simply does not work until you set this. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Before enabling this, confirm the browser-engine auth MODULE.md's redirect
# hazard note (finding C7) is resolved in your checkout.
CREDENTIAL_ENCRYPTION_KEY=
