# Pinned to the SAME base as services/ai-engine/Dockerfile, deliberately.
# Bare `python:3.12-slim` now resolves to trixie/GCC 14, where
# -Wincompatible-pointer-types is an error rather than a warning, so hdbscan
# 0.8.33's Cython-generated C does not compile. The test image must be able to
# install what production installs; otherwise the clustering suite falls back
# to SVD + k-means and characterises an algorithm the product never runs.
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY tests/requirements.txt .
# `uv`, matching services/ai-engine/Dockerfile. Plain `pip install` cannot build
# hdbscan 0.8.33 (no cp312 wheel; its legacy setup.py build fails under pip's
# build isolation even with build-essential present), while uv builds it the
# same way the ai-engine image already does. Using the same installer here
# keeps the test image on the SAME pinned versions as production instead of
# drifting to whatever ships a wheel -- a test environment that differs from
# the product certifies the environment, not the product.
RUN pip install uv
RUN uv pip install --system --no-cache-dir -r requirements.txt

COPY services/ ./services/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY docs/ ./docs/
COPY .github/ ./.github/
COPY Makefile ./Makefile
COPY docker-compose.yml ./docker-compose.yml
COPY .env.example ./.env.example
COPY .gitleaks.toml ./.gitleaks.toml
COPY pytest.ini ./pytest.ini
COPY tests/ ./tests/

ENV PYTHONPATH=/app

CMD ["pytest", "tests/", "-v"]
