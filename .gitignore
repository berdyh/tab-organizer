# Environment
.env
.env.local
.env.*.local
# The temp file `scripts/init.py` writes .env through. It holds the complete
# .env (API keys + all four bearer tokens); the writer unlinks it on failure,
# but a kill between write and rename leaves it behind, untracked and -- until
# this line -- stageable by `git add .`.
.env.tmp
# Same, for `scripts/cli.py`'s service-token store.
data/service-tokens.json.tmp

# Node / TypeScript (the wk1 facade onward)
node_modules/
# pnpm's content-addressable store and per-project state.
.pnpm-store/
# tsc scratch: present whenever anything switches to `--build` / project refs.
*.tsbuildinfo
# Next.js and Vite outputs, for the app package that lands in wk2.
.next/
.turbo/
# `dist/` and `build/` are already ignored above by the Python block, which is
# load-bearing here too -- do not "clean up" those lines.

# Docker
docker-compose.override.yml

# Testing
.pytest_cache/
# Not covered before. `.mypy_cache/` was invisible in `git status` only because
# mypy writes a self-ignoring `.gitignore` inside each cache dir -- delete that
# inner file and hundreds of KB of .db files become stageable.
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
test-results/
test-reports/
coverage/
bandit-report.json

